# Configure privately in .env.local. Never paste credentials into chat.
NEBIUS_API_KEY=
TAVILY_API_KEY=
SHIPTESTED_MODEL=nvidia/nemotron-3-super-120b-a12b

# Dedicated Neon database; never commit actual connection strings.
DATABASE_URL=
# SHA-256 hashes of two distinct random sc_ + 64-hex team access keys.
SHIPTESTED_PETER_KEY_HASH=
SHIPTESTED_LOUISE_KEY_HASH=
# Set a canonical origin only for a fixed host; preview otherwise uses incoming origin.
SHIPTESTED_APP_ORIGIN=

# GitHub identity only; configure a fixed origin and register its callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user IDs admitted to paid preview scans.
SHIPTESTED_GITHUB_MEMBER_IDS=
# Keep disabled until a cloud-test spending limit is agreed.
SHIPTESTED_REPAIR_SANDBOX_ENABLED=false
# Separate GitHub App installation for selected repository access.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Admin-approved actor ID -> installation ID mapping. Never populated from browser input.
SHIPTESTED_GITHUB_INSTALLATIONS={}

# Lifetime application-run allowance; review actual spend before increasing (1-5).
SHIPTESTED_REPAIR_TOTAL_RUNS=1
SHIPTESTED_REPAIR_DAILY_RUNS=1

# Public canonical URL (optional for local development)
NEXT_PUBLIC_SITE_URL=https://shiptested.com
SHIPTESTED_PUBLIC_DEMO=0

# Hosted workflow preview only; production currently forces demo mode in code.
SHIPTESTED_OPEN_REGISTRATION=0
# Set privately to a random value of at least 32 characters for trusted workers.
CRON_SECRET=
# Restricted Stripe TEST key and webhook signing secret; never use production keys for tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active GBP 300 / monthly / licensed-seat Price in the same Stripe test account.
STRIPE_TEAM_PRICE_ID=
SHIPTESTED_BILLING_LIVE=0
# Provisional included monthly scans per paid seat; overages are disabled.
SHIPTESTED_SCANS_PER_SEAT=5
