  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "description": "Ink-on-paper action; theme custom properties supply both variants.",
      "html": "<button class=\"ds-button ds-primary\">Open the report</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 15px;border:1px solid var(--card,rgb(255 255 255 / .16));border-radius:8px;font:500 14px var(--font-body,Inter),Arial,sans-serif;cursor:pointer;transition:transform 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),color 160ms,background-color 160ms}.ds-button:focus-visible{outline:2px solid var(--accent,#34D3B4);outline-offset:2px}.ds-button:active:not(:focus-visible){transform:scale(.97)}.ds-button:disabled{opacity:.65;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}.ds-button:active{transform:none}}.ds-primary{background:var(--p-bg,#EDF0F5);color:var(--p-fg,#0B0E13);border-color:var(--p-bg,#EDF0F5)}.ds-primary:hover{background:var(--primary-hover,#FFFFFF)}",
      "refersTo": "button-primary-dark"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "description": "Surface control for secondary actions.",
      "html": "<button class=\"ds-button ds-secondary\">Export CSV</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 15px;border:1px solid var(--card,rgb(255 255 255 / .16));border-radius:8px;font:500 14px var(--font-body,Inter),Arial,sans-serif;cursor:pointer;transition:transform 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),color 160ms,background-color 160ms}.ds-button:focus-visible{outline:2px solid var(--accent,#34D3B4);outline-offset:2px}.ds-button:active:not(:focus-visible){transform:scale(.97)}.ds-button:disabled{opacity:.65;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}.ds-button:active{transform:none}}.ds-secondary{background:var(--surface,#11151B);color:var(--text,#EDF0F5)}.ds-secondary:hover{background:var(--raised,#171C24)}",
      "refersTo": "button-secondary-dark"
    },
    {
      "name": "Scan input",
      "kind": "input",
      "description": "Labeled surface-backed field.",
      "html": "<label class=\"ds-label\" for=\"ds-project\">Project name</label><input class=\"ds-input\" id=\"ds-project\" placeholder=\"Your project\"/>",
      "css": ".ds-label{display:block;margin:18px 0 7px;font:500 13px var(--font-body,Inter),Arial,sans-serif;color:var(--text,#EDF0F5)}.ds-input{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--card,rgb(255 255 255 / .16));border-radius:8px;background:var(--surface,#11151B);color:var(--text,#EDF0F5);font:16px var(--font-body,Inter),Arial,sans-serif;caret-color:var(--accent,#34D3B4)}.ds-input:focus-visible{outline:2px solid var(--accent,#34D3B4);outline-offset:2px}.ds-input:disabled{background:var(--bg,#0B0E13)}",
      "refersTo": "input-dark"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "description": "Active destination and quiet secondary destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#reports\" aria-current=\"page\">Reports</a><a href=\"#scan\">New scan</a></nav>",
      "css": ".ds-nav{padding:16px;background:var(--surface,#11151B);font:14px var(--font-body,Inter),Arial,sans-serif}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:12px;border-radius:9px;color:var(--muted,#8E98A6);text-decoration:none}.ds-nav a[aria-current]{background:var(--raised,#171C24);color:var(--accent,#34D3B4)}.ds-nav a:hover{background:var(--raised,#171C24)}.ds-nav a:focus-visible{outline:2px solid var(--accent,#34D3B4);outline-offset:2px}"
    },
    {
      "name": "Severity chip",
      "kind": "chip",
      "description": "High severity with dot and text; static status, not a button.",
      "html": "<span class=\"ds-severity\">High</span>",
      "css": ".ds-severity{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:5px;font:500 13px/1.4 var(--font-body,Inter),Arial,sans-serif;color:var(--hi-fg,#FF7B7B);background:color-mix(in srgb,var(--hi-fg,#FF7B7B) 12%,var(--surface,#11151B))}.ds-severity:before{content:\"\";width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Repair evidence card",
      "kind": "card",
      "description": "Waiting state avoids invented runner evidence.",
      "html": "<div class=\"ds-card\"><strong>Tests before</strong><p>Not yet recorded</p></div>",
      "css": ".ds-card{padding:16px;border:1px solid var(--line,rgb(255 255 255 / .08));border-radius:12px;background:var(--bg,#0B0E13);color:var(--text,#EDF0F5);font:16px/1.5 var(--font-body,Inter),Arial,sans-serif}.ds-card strong{font-weight:600}.ds-card p{margin:0}"
    },
    {
      "name": "Voyage moment",
      "kind": "custom",
      "description": "Scene-local event summary; illustrative preview text is not run evidence.",
      "html": "<div class=\"ds-moment\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 8 3 3 7-8\"/></svg><strong>Lockfile</strong><span>\u00b7 Complete</span></div>",
      "css": ".ds-moment{display:inline-flex;align-items:center;gap:5px;height:32px;padding:6px 10px;border-radius:999px;border:1px solid var(--line,rgb(255 255 255 / .08));background:var(--surface,#11151B);color:var(--text,#EDF0F5);box-shadow:0 4px 16px var(--shadow-soft,rgb(0 0 0 / .16));font:13px/1.4 var(--font-body,Inter),Arial,sans-serif}.ds-moment strong{font-weight:600}.ds-moment span{color:var(--body2,#B4BCC8)}.ds-moment svg{color:var(--accent,#34D3B4)}",
      "refersTo": "moment-dark"
    }
  ],
  "narrative": {
    "northStar": "The sailing journey",
    "overview": "A release is a boat, checks are buoys, and the verdict waits at the lighthouse. The landing page gives the voyage room to lead. Reports remain calm, specific and readable, with evidence and next actions first. The clean mark handles quiet states without the voyage sketch treatment.",
    "keyCharacteristics": [
      "Recorded sailing hero",
      "Ink-and-paper controls",
      "Theme-aware semantic severity",
      "Static reduced-motion frames"
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Verdict and severity colors reflect recorded data and accompany a label or shape.",
        "section": "colors"
      },
      {
        "name": "The Reading First Rule",
        "body": "Reserve Caveat for drawing annotations; keep evidence readable.",
        "section": "typography"
      },
      {
        "name": "The State Change Rule",
        "body": "Motion explains change; initial report elements and header marks are static.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do derive metrics and versions from real evidence.",
      "Do preserve both themes and accessible logs.",
      "Do keep queued scans honest while the API is nonstreaming."
    ],
    "donts": [
      "Don't invent progress or individual test counts.",
      "Don't claim a Rive runtime or file exists.",
      "Don't treat the documentation as deployment or approval evidence."
    ]
  }
