{
  "name": "shiptested",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3147",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3147",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:smoke": "node --env-file=.env.local --import tsx scripts/db-smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/sandbox": "3.9.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "^7.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
